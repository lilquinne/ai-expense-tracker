# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ======================================
# Security - API Keys & Credentials
# ======================================

# Environment files (already covered above, but safe to keep)
# .env
# .env.*

# Allow example environment files without real secrets
!.env.example

# Private credentials
*.pem
*.p12
*.pfx
*service-account*.json

# Android signing credentials
android/key.properties
*.jks
*.keystore

# Supabase local configuration
supabase/.branches/
supabase/.profiles/

# Local database files (if used for private data)
*.sqlite
*.sqlite3

# Generated Flutter and Android build files
**/build/
**/.dart_tool/
**/outputs/
**/intermediates/

# Generated application packages
*.apk
*.aab
*.ipa

# Generated temporary files
/output/
/tmp/
/artifacts/

# Ignore generated build files in all directories
**/build/
**/.dart_tool/

# Ignore generated application packages
*.apk
*.aab
*.ipa

# Ignore generated outputs
/output/
/tmp/
/artifacts/

# Ignore local secrets
.env
.env.*
!.env.example

# Android generated files
android/app/build/
android/build/
android/.gradle/
.gradle/